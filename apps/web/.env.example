# Copy to .env.local and fill in. Never commit .env.local (see .gitignore).
#
# Public values — safe to expose to the browser. These are the ONLY Supabase
# values that may carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-start

# Which Juleb driver to use. Keep this on "mock" until a real API spec and
# sandbox credentials exist. See BUILD_SPLENDMED.md §3.1 and §8.2.
JULEB_DRIVER=mock

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — never prefix any of these with NEXT_PUBLIC_ (§3.4).
# In deployment these live in Supabase Function secrets / the host's secret
# store, not in a file. Listed here only so the required names are discoverable.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# JULEB_BASE_URL=
# JULEB_CLIENT_ID=
# JULEB_CLIENT_SECRET=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
